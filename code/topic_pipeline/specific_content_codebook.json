      },
      {
        "id": "T05.03",
        "name_zh": "购物、跑腿与预约",
        "definition_zh": "讨论购买生活用品、日常跑腿或安排预约。"
      },
      {
        "id": "T05.04",
        "name_zh": "搬家、维修与园艺",
        "definition_zh": "讨论搬运、搬家、家庭维修、院落或园艺事务。"
      },
      {
        "id": "T05.05",
