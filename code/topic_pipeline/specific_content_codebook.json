[
  {
    "topic_id": "T01",
    "name_zh": "工作与求职",
    "subtopics": [
      {
        "id": "T01.01",
        "name_zh": "工作量、工时与排班",
        "definition_zh": "具体讨论任务多少、加班、工作时长、排班或培训任务。"
      },
      {
        "id": "T01.02",
        "name_zh": "休假与工作生活安排",
        "definition_zh": "讨论工作休假、下班恢复、工作与家庭或私人时间的安排。"
      },
      {
        "id": "T01.03",
        "name_zh": "同事、客户与职场管理",
        "definition_zh": "讨论同事客户沟通、领导管理、职场冲突或协作。"
      },
      {
        "id": "T01.04",
        "name_zh": "工作待遇与认可",
        "definition_zh": "讨论薪酬、劳动待遇、被认可或职场中的不公平对待。"
      },
      {
        "id": "T01.05",
        "name_zh": "求职、离职与职业选择",
        "definition_zh": "讨论找工作、辞职、换工作或职业方向。"
      },
      {
        "id": "T01.06",
        "name_zh": "职业倦怠与工作动力",
        "definition_zh": "必须明确工作或职业经历，讨论工作倦怠、继续工作的意愿或工作意义；一般做事无动力、情绪调节或人生反思不能推断就业。"
      }
    ]
  },
  {
    "topic_id": "T02",
    "name_zh": "学习与考试",
    "subtopics": [
      {
        "id": "T02.01",
        "name_zh": "课程、作业与学业任务",
        "definition_zh": "讨论上课、课程练习、作业、论文等具体学业任务。"
      },
      {
        "id": "T02.02",
        "name_zh": "备考与考试表现",
        "definition_zh": "讨论准备考试、考研、考试过程或成绩表现。"
      },
      {
        "id": "T02.03",
        "name_zh": "截止时间与学校申请",
        "definition_zh": "讨论学业截止日期、赶交材料或学校申请手续。"
      },
      {
        "id": "T02.04",
        "name_zh": "学习方法与时间安排",
        "definition_zh": "讨论学习工具、方法、学习计划及学习与其他生活的安排。"
      },
      {
        "id": "T02.05",
        "name_zh": "学业动力与毕业担忧",
        "definition_zh": "明确讨论学习意愿、学业前景或毕业担忧；仅提到年级，或作业完成后累，不算动力问题。"
      }
    ]
  },
  {
    "topic_id": "T03",
    "name_zh": "睡眠与作息",
    "subtopics": [
      {
        "id": "T03.01",
        "name_zh": "睡眠时长与醒后困倦",
        "definition_zh": "讨论睡了多久、睡不够、早起困难或醒后仍困。"
      },
      {
        "id": "T03.02",
        "name_zh": "入睡困难、夜醒与噩梦",
        "definition_zh": "明确讨论失眠、入睡困难、夜间醒来或噩梦。"
      },
      {
        "id": "T03.03",
        "name_zh": "小睡、补觉与休息",
        "definition_zh": "讨论午睡、补觉、躺下休息或具体的恢复安排。"
      },
      {
        "id": "T03.04",
        "name_zh": "作息与睡前安排",
        "definition_zh": "讨论何时睡觉、早睡晚睡、作息调整或睡前活动。"
      },
      {
        "id": "T03.05",
        "name_zh": "身体与环境对睡眠的影响",
        "definition_zh": "明确把睡眠与病痛、用药、气温、噪声等身体或环境因素联系起来。"
      }
    ]
  },
  {
    "topic_id": "T04",
    "name_zh": "健康与就医",
    "subtopics": [
      {
        "id": "T04.01",
        "name_zh": "疾病、疼痛与身体症状",
        "definition_zh": "讨论自述疾病、疼痛、身体症状或身体功能不适。"
      },
      {
        "id": "T04.02",
        "name_zh": "心理困扰与创伤",
        "definition_zh": "讨论明说的心理困扰、抑郁、焦虑或创伤经历；不替作者诊断。"
      },
      {
        "id": "T04.03",
        "name_zh": "药物作用与副作用",
        "definition_zh": "讨论具体用药及其作用、嗜睡等反应或副作用。"
      },
      {
        "id": "T04.04",
        "name_zh": "检查、就医与治疗",
        "definition_zh": "讨论预约、看病、检查、治疗及医疗过程。"
      },
      {
        "id": "T04.05",
        "name_zh": "康复与生活限制",
        "definition_zh": "讨论恢复过程以及健康状况对生活或活动能力的限制。"
      }
    ]
  },
  {
    "topic_id": "T05",
